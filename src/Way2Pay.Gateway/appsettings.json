{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "payments": {
        "ClusterId": "payments",
        "AuthorizationPolicy": "MerchantApiKey",
        "Match": {
          "Path": "/payments/{**remainder}",
          "Methods": [ "GET", "POST" ]
        }
      },
      "register-card": {
        "ClusterId": "cardvault",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/cards",
          "Methods": [ "POST" ]
        }
      },
      "create-card-registration-session": {
        "ClusterId": "cardvault",
        "AuthorizationPolicy": "MerchantApiKey",
        "Match": {
          "Path": "/card-registration-sessions",
          "Methods": [ "POST" ]
        }
      },
      "payments-openapi": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/openapi/payments.json",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathSet": "/openapi/public-v1.json" }
        ]
      },
      "merchants-admin-openapi": {
        "ClusterId": "merchants",
        "Match": {
          "Path": "/openapi/merchants-admin.json",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathSet": "/openapi/admin-v1.json" }
        ]
      },
      "cards-openapi": {
        "ClusterId": "cardvault",
        "Match": {
          "Path": "/openapi/cards.json",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathSet": "/openapi/public-v1.json" }
        ]
      }
    },
    "Clusters": {
      "payments": {
        "Destinations": {
          "default": {
            "Address": "https+http://way2pay-payments-api/"
          }
        }
      },
      "merchants": {
        "Destinations": {
          "default": {
            "Address": "https+http://way2pay-merchants-api/"
          }
        }
      },
      "cardvault": {
        "Destinations": {
          "default": {
            "Address": "https+http://way2pay-cardvault/"
          }
        }
      }
    }
  }
}
